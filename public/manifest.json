{
  "manifest_version": 3,
  "name": "Price Scout",
  "version": "0.7.0",
  "description": "Rank Amazon.in, Flipkart (incl. Minutes), DMart, Blinkit, Zepto, BigBasket and Swiggy Instamart results by price per 100 g / 100 ml. Click the icon to try again on any page.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Price Scout: show value per 100 g / 100 ml on this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.amazon.in/*",
        "*://www.flipkart.com/*",
        "*://www.dmart.in/*",
        "*://blinkit.com/*",
        "*://www.blinkit.com/*",
        "*://www.zepto.com/*",
        "*://zepto.com/*",
        "*://www.bigbasket.com/*",
        "*://www.swiggy.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "*://www.amazon.in/*",
    "*://www.flipkart.com/*",
    "*://www.dmart.in/*",
    "*://blinkit.com/*",
    "*://www.blinkit.com/*",
    "*://www.zepto.com/*",
    "*://zepto.com/*",
    "*://www.bigbasket.com/*",
    "*://www.swiggy.com/*"
  ]
}
