{
  "manifest_version": 3,
  "name": "Price Scout",
  "version": "0.4.0",
  "description": "Rank Amazon.in and Flipkart search results by price per 100 g / 100 ml.",
  "content_scripts": [
    {
      "matches": ["*://www.amazon.in/*", "*://www.flipkart.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
